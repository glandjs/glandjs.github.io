---
/**
 * Top navigation bar (Starlight `Header` override).
 *
 * `Search` and `ThemeSelect` are Starlight's own components, re-used so that
 * Pagefind indexing, the ⌘K shortcut and the persisted colour-scheme
 * preference keep working exactly as they do upstream.
 */
import Search from '@astrojs/starlight/components/Search.astro'
import ThemeSelect from '@astrojs/starlight/components/ThemeSelect.astro'
import { Icon } from '@astrojs/starlight/components'

import logo from '../assets/gland-logo.svg'

const { pathname } = Astro.url

const links = [
  {
    label: 'Docs',
    href: '/introduction/what-is-gland',
    match: /^\/(introduction|getting-started|fundamentals|guides|faq|documentation)/,
  },
  { label: 'Packages', href: '/packages/core', match: /^\/packages/ },
  { label: 'Changelog', href: '/changelog/emitter', match: /^\/changelog/ },
]

const isCurrent = (match: RegExp) => match.test(pathname)
---

<header class="site-header">
  <a href="/" class="site-header__brand" aria-label="Gland — home">
    <span class="site-header__logo">
      <img src={logo.src} alt="" width="28" height="25" />
    </span>
    <span class="site-header__word" translate="no">Gland</span>
  </a>

  <a class="site-header__version" href="/changelog/emitter">v1.1.4</a>

  <nav class="site-header__nav" aria-label="Main">
    {
      links.map((link) => (
        <a
          href={link.href}
          class="site-header__link"
          aria-current={isCurrent(link.match) ? 'page' : undefined}
        >
          {link.label}
        </a>
      ))
    }
  </nav>

  <div class="site-header__spacer"></div>

  <div class="site-search print:hidden">
    <Search />
  </div>

  <div class="site-header__actions print:hidden">
    <a
      class="site-header__icon-link site-header__icon-link--secondary"
      href="https://github.com/glandjs/glandjs.github.io"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Gland on GitHub"
    >
      <Icon name="github" class="size-5" />
    </a>
    <a
      class="site-header__icon-link site-header__icon-link--secondary"
      href="https://discord.gg/glandjs"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Gland community on Discord"
    >
      <Icon name="discord" class="size-5" />
    </a>
    <ThemeSelect />
  </div>
</header>
