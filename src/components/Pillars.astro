---
/**
 * The "Why Gland?" pillars shown on the documentation home page.
 * Kept in one place so the marketing copy and the docs never drift apart.
 */
const pillars = [
  {
    title: 'Event-driven by default',
    body: 'Controllers never call business logic directly. They emit a domain event, and channels decide what happens. Side effects become observable, replaceable and testable.',
  },
  {
    title: 'Protocol-agnostic',
    body: 'Transport lives in brokers. The same controllers and channels run over HTTP today, and over WebSocket or RPC tomorrow — only the adapter wiring changes.',
  },
  {
    title: 'Tiny primitives',
    body: 'The emitter is three methods and under 2 KB. The broker adds channels and meshes on top of it. Nothing is hidden from you, and there is nothing to unlearn.',
  },
  {
    title: 'TypeScript-first',
    body: 'Event names and payload shapes live in one typed map. A renamed event or a changed payload is a compile error, not a production incident.',
  },
  {
    title: 'Testable by construction',
    body: 'A controller test asserts the events it emitted. A channel test calls a handler with a fake context. Because side effects are concentrated in channels, test suites stay small.',
  },
  {
    title: 'Gradually adoptable',
    body: 'Install only the packages you need. Keep your existing HTTP layer and mount Gland channels next to it. There is no big-bang migration.',
  },
]
---

<div class="features">
  {
    pillars.map((pillar) => (
      <div class="feature">
        <span class="title">{pillar.title}</span>
        <p>{pillar.body}</p>
      </div>
    ))
  }
</div>
